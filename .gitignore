# ======================================
# FraudShield AI — .gitignore
# ======================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
venv/
env/
.venv/
.env
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# --- ML Artifacts & Data (NEVER commit sensitive data) ---
ml/data/raw/
ml/data/processed/
ml/models/*/model_logreg_*.joblib
ml/models/*/model_isoforest_*.joblib
ml/models/*/scaler.joblib
ml/models/*/shap_*.joblib
# Keep model_card.md and metrics.json (they are documentation, not binary)
!ml/models/model_card.md
!ml/models/*/metrics_*.json
!ml/models/*/model_registry_entry.json
# Demo data (generated, not raw)
ml/data/demo/

# --- Node.js ---
node_modules/
.next/
.nuxt/
dist/
.turbo/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment Variables (CRITICAL — never commit secrets) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
apps/api/.env
apps/web/.env.local
# Keep the example files:
!.env.example
!apps/api/.env.example
!apps/web/.env.example

# --- Docker ---
docker-compose.override.yml

# --- Database ---
*.db
*.sqlite
*.sqlite3
postgres-data/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs ---
logs/
*.log

# --- OS ---
.DS_Store
ehthumbs.db
Desktop.ini

# --- Reports (generated, not source) ---
reports/
*.pdf

# --- Certificates (use secrets manager in prod) ---
*.pem
*.key
*.crt
