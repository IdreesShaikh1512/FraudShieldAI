# ======================================
# FraudShield AI — Environment Variables
# Copy this to .env and fill in values.
# NEVER commit the actual .env file.
# ======================================

# --- Application ---
APP_NAME=FraudShield AI
ENVIRONMENT=development                    # development | production

# --- Database ---
POSTGRES_USER=fraudshield
POSTGRES_PASSWORD=fraudshield_secret_change_me
POSTGRES_DB=fraudshield
DATABASE_URL=postgresql+asyncpg://fraudshield:fraudshield_secret_change_me@localhost:5432/fraudshield
# For Docker Compose, use the service name as the host:
# DATABASE_URL=postgresql+asyncpg://fraudshield:fraudshield_secret_change_me@fraudshield-db:5432/fraudshield

# --- Security (JWT) ---
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_USE_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS_LONG_XXXXXXXXX
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- ML Models ---
# Path to the ml/models directory (relative to the API service root)
MODEL_DIR=../../ml/models

# --- Rate Limiting ---
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_PREDICT=60/minute

# --- Email (Stubbed — configure for production) ---
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_mailtrap_user
# SMTP_PASS=your_mailtrap_pass
# EMAIL_FROM=noreply@fraudshield.ai

# --- Logging ---
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=FraudShield AI
